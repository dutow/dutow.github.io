\mode<presentation>

\setbeamercolor*{normal text}{fg=percona-2026white,bg=percona-2026black}
\setbeamercolor*{title page header}{fg=percona-2026yellow}
\setbeamercolor*{subtitle}{fg=percona-2026white}
\setbeamercolor*{author}{fg=percona-2026white}
\setbeamercolor*{institute}{fg=percona-2026white}
\setbeamercolor*{ty}{fg=percona-2026black}
\setbeamercolor*{notes}{fg=percona-2026yellow}
\setbeamercolor*{notesexpanded}{fg=percona-2026black}
\setbeamercolor*{date}{fg=percona-2026white}
\setbeamercolor{section}{fg=white,bg=}
\setbeamercolor{subsection}{fg=white,bg=}
\setbeamercolor*{frametitle}{fg=percona-2026white}
\setbeamercolor*{framenumber}{fg=percona-2026tint4}
\setbeamercolor*{copyright}{fg=percona-2026tint4}

%List markers
\setbeamercolor*{itemize item}{fg=percona-2026white}
\setbeamercolor*{itemize subitem}{fg=percona-2026white}
\setbeamercolor*{itemize subsubitem}{fg=percona-2026white}
%List text
\setbeamercolor{itemize/enumerate body}{fg=percona-2026white}
\setbeamercolor{itemize/enumerate subbody}{fg=percona-2026white}
\setbeamercolor{itemize/enumerate subsubbody}{fg=percona-2026white}

\setbeamercolor*{section in toc}{fg=percona-2026white}
\setbeamercolor*{subsection in toc}{fg=percona-2026white}

\def\percona_2026_defaultcolor{percona-2026blue}

\hypersetup{
  colorlinks=true,
  linkcolor=,
  urlcolor=percona-2026blue
}

\makeatletter
\def\verbatim@font{\footnotesize\ttfamily\color{\percona_2026_defaultcolor}}
\makeatother

\mode<all>
